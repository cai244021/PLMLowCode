{
  "formatVersion": 1,
  "pageCode": "JF_PROJECT_TASK_STATUS_REPORT",
  "pageName": "项目任务状态报表",
  "version": 1,
  "schema": {
    "type": "page",
    "id": "u:project-task-report-page",
    "title": "项目任务状态报表",
    "className": "bg-white",
    "body": [
      {
        "type": "service",
        "id": "u:project-task-summary-service",
        "name": "projectTaskSummary",
        "api": {"data": {"reportCode": "PROJECT_TASK_STATUS"}},
        "body": [
          {
            "type": "alert",
            "level": "${insight.level}",
            "showIcon": true,
            "body": "${insight.message}",
            "visibleOn": "${insight && insight.message}"
          },
          {
            "type": "cards",
            "source": "${metrics || []}",
            "columnsCount": 4,
            "card": {
              "useCardLabel": false,
              "className": "shadow-sm",
              "header": {
                "className": {
                  "bg-blue-50": "${level === 'primary'}",
                  "bg-red-50": "${level === 'danger'}",
                  "bg-yellow-50": "${level === 'warning'}",
                  "bg-green-50": "${level === 'success'}"
                },
                "title": "${label}",
                "titleClassName": "font-semibold text-gray-700"
              },
              "body": [
                {
                  "type": "button",
                  "label": "${value}${unit}",
                  "level": "${level}",
                  "size": "lg",
                  "className": "font-bold",
                  "style": {"fontSize": "28px", "lineHeight": "36px", "height": "auto", "minWidth": "96px", "padding": "4px 20px"},
                  "actionType": "button",
                  "onEvent": {
                    "click": {
                      "actions": [
                        {
                          "actionType": "reload",
                          "componentName": "reportDetailList",
                          "data": {"scope": "${scope}", "page": 1},
                          "args": {"resetPage": true},
                          "ignoreError": false
                        }
                      ]
                    }
                  }
                },
                {"type": "tpl", "tpl": "点击数字筛选下方明细", "className": "text-gray-500 m-t-sm"}
              ]
            }
          },
          {
            "type": "grid",
            "gap": "md",
            "columns": [
              {
                "md": 6,
                "body": {
                  "type": "panel",
                  "title": "${charts[0].title}",
                  "visibleOn": "${charts && charts[0]}",
                  "body": {
                    "type": "chart",
                    "height": 300,
                    "replaceChartOption": true,
                    "trackExpression": "${charts[0]|json}",
                    "config": {
                      "tooltip": {"trigger": "axis"},
                      "grid": {"left": 40, "right": 20, "top": 20, "bottom": 45, "containLabel": true},
                      "xAxis": {"type": "category", "data": "${charts[0].option.xAxis.data}", "axisLabel": {"interval": 0, "rotate": 20}},
                      "yAxis": {"type": "value", "minInterval": 1},
                      "series": [{"type": "bar", "data": "${charts[0].option.series[0].data}", "barMaxWidth": 48}]
                    }
                  }
                }
              },
              {
                "md": 6,
                "body": {
                  "type": "panel",
                  "title": "${charts[1].title}",
                  "visibleOn": "${charts && charts[1]}",
                  "body": {
                    "type": "chart",
                    "height": 300,
                    "replaceChartOption": true,
                    "trackExpression": "${charts[1]|json}",
                    "config": {
                      "tooltip": {"trigger": "item"},
                      "legend": {"bottom": 0},
                      "series": [{"type": "pie", "radius": ["35%", "65%"], "center": ["50%", "45%"], "data": "${charts[1].option.series[0].data}"}]
                    }
                  }
                }
              }
            ]
          },
          {
        "type": "crud",
        "id": "u:project-task-list",
        "name": "reportDetailList",
        "title": "项目任务明细",
        "syncLocation": false,
        "primaryField": "id",
        "loadDataOnce": false,
        "perPage": 20,
        "alwaysShowPagination": true,
        "perPageAvailable": [10, 20, 50, 100],
        "api": {"data": {
          "reportCode": "PROJECT_TASK_STATUS",
          "scope": "${scope}",
          "page": "${page}",
          "perPage": "${perPage}",
          "orderBy": "${orderBy}",
          "orderDir": "${orderDir}",
          "projectKeyword": "${projectKeyword}",
          "taskKeyword": "${taskKeyword}",
          "current": "${current}",
          "owner": "${owner}",
          "plannedRange": "${plannedRange}"
        }},
        "filterTogglable": true,
        "filterDefaultVisible": true,
        "filter": {
          "type": "form",
          "title": "",
          "mode": "inline",
          "wrapWithPanel": false,
          "body": [
            {"type": "input-text", "name": "projectKeyword", "label": "项目", "clearable": true},
            {"type": "input-text", "name": "taskKeyword", "label": "任务", "clearable": true},
            {"type": "select", "name": "current", "label": "状态", "clearable": true, "source": "${filterOptions.current}"},
            {"type": "select", "name": "owner", "label": "责任人", "clearable": true, "searchable": true, "source": "${filterOptions.owner}"},
            {"type": "input-date-range", "name": "plannedRange", "label": "计划完成日期", "format": "YYYY-MM-DD", "joinValues": false},
            {"type": "submit", "label": "查询", "level": "primary"},
            {"type": "reset", "label": "重置"}
          ],
          "actions": []
        },
        "headerToolbar": ["filter-toggler", "reload"],
        "footerToolbar": ["statistics", "switch-per-page", "pagination"],
        "columns": [
          {"name": "projectName", "label": "项目名称", "width": 160, "fixed": "left", "sortable": true},
          {"name": "name", "label": "任务名称", "width": 180, "sortable": true},
          {"name": "milestone", "label": "里程碑", "width": 130, "sortable": true},
          {"name": "currentLabel", "label": "状态", "width": 90, "sortable": true},
          {"name": "progress", "label": "完成度", "type": "progress", "width": 120, "showLabel": true, "sortable": true},
          {"name": "riskLevel", "label": "进度风险", "type": "mapping", "width": 90, "map": {
            "success": "<span class='label label-success'>正常</span>",
            "warning": "<span class='label label-warning'>临期</span>",
            "danger": "<span class='label label-danger'>延期</span>"
          }},
          {"name": "owner", "label": "责任人", "width": 110, "sortable": true},
          {"name": "plannedStart", "label": "计划开始", "type": "date", "width": 120, "sortable": true},
          {"name": "plannedFinish", "label": "计划完成", "type": "date", "width": 120, "sortable": true},
          {"name": "actualFinish", "label": "实际完成", "type": "date", "width": 120, "sortable": true},
          {"name": "delayDays", "label": "延期天数", "type": "number", "width": 90, "sortable": true},
          {"name": "predecessor", "label": "前置任务", "width": 150},
          {"name": "objectId", "label": "任务对象ID", "width": 220, "toggled": false}
        ]
          }
        ]
      }
    ]
  },
  "plmConfig": {
    "fieldCodes": [],
    "actionCodes": ["QUERY_PLM_REPORT_SUMMARY", "QUERY_PLM_REPORT_DETAILS"],
    "context": {"objectIdParam": "objectId", "parentOidParam": "parentOID", "relIdParam": "relId"},
    "fieldBindings": [],
    "dataBindings": [
      {"componentId": "u:project-task-summary-service", "trigger": "INIT", "actionCode": "QUERY_PLM_REPORT_SUMMARY"}
    ],
    "actionBindings": [],
    "tableBindings": [
      {
        "componentId": "u:project-task-list",
        "queryActionCode": "QUERY_PLM_REPORT_DETAILS",
        "itemsPath": "data.items",
        "totalPath": "data.total",
        "objectIdField": "objectId",
        "relIdField": "id[connection]",
        "columnBindings": []
      }
    ],
    "searchBindings": []
  }
}
