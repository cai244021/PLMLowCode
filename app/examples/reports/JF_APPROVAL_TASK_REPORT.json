{
  "formatVersion": 1,
  "pageCode": "JF_APPROVAL_TASK_REPORT",
  "pageName": "审核任务智能报表",
  "version": 1,
  "schema": {
    "type": "page",
    "id": "u:approval-report-page",
    "title": "审核任务智能报表",
    "className": "bg-white",
    "body": [
      {
        "type": "service",
        "id": "u:approval-report-summary-service",
        "name": "approvalReportSummary",
        "api": {"data": {"reportCode": "APPROVAL_TASK"}},
        "body": [
          {
            "type": "alert",
            "level": "${insight.level}",
            "showIcon": true,
            "body": "${insight.message}",
            "visibleOn": "${insight && insight.message}"
          },
          {
            "type": "cards",
            "source": "${metrics || []}",
            "columnsCount": 4,
            "card": {
              "useCardLabel": false,
              "className": "shadow-sm",
              "header": {
                "className": {
                  "bg-blue-50": "${level === 'primary'}",
                  "bg-red-50": "${level === 'danger'}",
                  "bg-yellow-50": "${level === 'warning'}",
                  "bg-green-50": "${level === 'success'}"
                },
                "title": "${label}",
                "titleClassName": "font-semibold text-gray-700"
              },
              "body": [
                {
                  "type": "button",
                  "label": "${value}${unit}",
                  "level": "${level}",
                  "size": "lg",
                  "className": "font-bold",
                  "style": {"fontSize": "28px", "lineHeight": "36px", "height": "auto", "minWidth": "96px", "padding": "4px 20px"},
                  "actionType": "button",
                  "onEvent": {
                    "click": {
                      "actions": [
                        {
                          "actionType": "reload",
                          "componentName": "reportDetailList",
                          "data": {"scope": "${scope}", "page": 1},
                          "args": {"resetPage": true},
                          "ignoreError": false
                        }
                      ]
                    }
                  }
                },
                {"type": "tpl", "tpl": "点击数字筛选下方明细", "className": "text-gray-500 m-t-sm"}
              ]
            }
          },
          {
            "type": "grid",
            "gap": "md",
            "columns": [
              {
                "md": 6,
                "body": {
                  "type": "panel",
                  "title": "${charts[0].title}",
                  "visibleOn": "${charts && charts[0]}",
                  "body": {
                    "type": "chart",
                    "height": 280,
                    "replaceChartOption": true,
                    "trackExpression": "${charts[0]|json}",
                    "config": {
                      "tooltip": {"trigger": "axis"},
                      "grid": {"left": 40, "right": 20, "top": 20, "bottom": 45, "containLabel": true},
                      "xAxis": {"type": "category", "data": "${charts[0].option.xAxis.data}", "axisLabel": {"interval": 0, "rotate": 20}},
                      "yAxis": {"type": "value", "minInterval": 1},
                      "series": [{"type": "bar", "data": "${charts[0].option.series[0].data}", "barMaxWidth": 48}]
                    }
                  }
                }
              },
              {
                "md": 6,
                "body": {
                  "type": "panel",
                  "title": "${charts[1].title}",
                  "visibleOn": "${charts && charts[1]}",
                  "body": {
                    "type": "chart",
                    "height": 280,
                    "replaceChartOption": true,
                    "trackExpression": "${charts[1]|json}",
                    "config": {
                      "tooltip": {"trigger": "item"},
                      "legend": {"bottom": 0},
                      "series": [{"type": "pie", "radius": ["35%", "65%"], "center": ["50%", "45%"], "data": "${charts[1].option.series[0].data}"}]
                    }
                  }
                }
              }
            ]
          },
          {
        "type": "crud",
        "id": "u:approval-task-list",
        "name": "reportDetailList",
        "title": "任务明细",
        "syncLocation": false,
        "primaryField": "id",
        "loadDataOnce": false,
        "perPage": 20,
        "alwaysShowPagination": true,
        "autoFillHeight": false,
        "perPageAvailable": [10, 20, 50, 100],
        "api": {
          "data": {
            "reportCode": "APPROVAL_TASK",
            "scope": "${scope}",
            "page": "${page}",
            "perPage": "${perPage}",
            "orderBy": "${orderBy}",
            "orderDir": "${orderDir}",
            "keyword": "${keyword}",
            "taskType": "${taskType}",
            "riskLevel": "${riskLevel}",
            "dueDateRange": "${dueDateRange}"
          }
        },
        "filterTogglable": true,
        "filterDefaultVisible": true,
        "filter": {
          "type": "form",
          "title": "",
          "mode": "inline",
          "wrapWithPanel": false,
          "body": [
            {"type": "input-text", "name": "keyword", "label": "标题/名称", "clearable": true},
            {"type": "select", "name": "taskType", "label": "任务类型", "clearable": true, "source": "${filterOptions.taskType}"},
            {"type": "select", "name": "riskLevel", "label": "风险等级", "clearable": true, "source": "${filterOptions.riskLevel}"},
            {"type": "input-date-range", "name": "dueDateRange", "label": "到期日期", "format": "YYYY-MM-DD", "joinValues": false},
            {"type": "submit", "label": "查询", "level": "primary"},
            {"type": "reset", "label": "重置"}
          ],
          "actions": []
        },
        "headerToolbar": ["filter-toggler", "reload"],
        "footerToolbar": ["statistics", "switch-per-page", "pagination"],
        "columns": [
          {"name": "name", "label": "任务名称", "width": 150, "sortable": true},
          {"name": "routeTitle", "label": "审核流程", "width": 180, "sortable": true},
          {"name": "taskTypeLabel", "label": "任务类型", "width": 120, "sortable": true},
          {"name": "businessObjectName", "label": "业务对象", "width": 180, "sortable": true},
          {"name": "currentLabel", "label": "状态", "width": 90, "sortable": true},
          {"name": "riskLevel", "label": "风险", "type": "mapping", "width": 80, "map": {
            "success": "<span class='label label-success'>正常</span>",
            "warning": "<span class='label label-warning'>临期</span>",
            "danger": "<span class='label label-danger'>逾期</span>"
          }},
          {"name": "dueDate", "label": "要求完成时间", "type": "datetime", "width": 165, "sortable": true},
          {"name": "overdueDays", "label": "逾期天数", "type": "number", "width": 90, "sortable": true},
          {"name": "owner", "label": "责任人", "width": 110, "sortable": true},
          {"name": "originated", "label": "创建时间", "type": "datetime", "width": 165, "sortable": true},
          {"name": "objectId", "label": "业务对象ID", "width": 220, "toggled": false}
        ]
          }
        ]
      }
    ]
  },
  "plmConfig": {
    "fieldCodes": [],
    "actionCodes": ["QUERY_PLM_REPORT_SUMMARY", "QUERY_PLM_REPORT_DETAILS"],
    "context": {
      "objectIdParam": "objectId",
      "parentOidParam": "parentOID",
      "relIdParam": "relId"
    },
    "fieldBindings": [],
    "dataBindings": [
      {
        "componentId": "u:approval-report-summary-service",
        "trigger": "INIT",
        "actionCode": "QUERY_PLM_REPORT_SUMMARY"
      }
    ],
    "actionBindings": [],
    "tableBindings": [
      {
        "componentId": "u:approval-task-list",
        "queryActionCode": "QUERY_PLM_REPORT_DETAILS",
        "itemsPath": "data.items",
        "totalPath": "data.total",
        "objectIdField": "objectId",
        "relIdField": "id[connection]",
        "columnBindings": []
      }
    ],
    "searchBindings": []
  }
}
